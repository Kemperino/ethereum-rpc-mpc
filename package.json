{
  "name": "ethereum-rpc-mpc",
  "version": "1.0.6",
  "main": "dist/server/index.js",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ethereum-rpc-mpc": "./dist/server/index.js"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "prepublishOnly": "yarn run build",
    "build": "tsc",
